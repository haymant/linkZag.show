{
  "name": "linkzag-show",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic scene renderer and segment factory for commentary videos.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@linkzag/studio",
    "dev:renderer": "npm run dev --workspace=@linkzag/renderer --",
    "build": "npm run build --workspace=@linkzag/renderer && npm run build --workspace=@linkzag/studio",
    "preview": "npm run preview --workspace=@linkzag/renderer",
    "linkzag": "tsx packages/cli/src/index.ts",
    "render": "tsx packages/cli/src/index.ts render",
    "capture": "tsx packages/cli/src/index.ts capture",
    "video": "tsx packages/cli/src/index.ts video",
    "segment": "tsx packages/cli/src/index.ts segment",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:golden": "playwright test tests/e2e/golden.spec.ts",
    "goldens:update": "tsx scripts/make-goldens.ts",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
